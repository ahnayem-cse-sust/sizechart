{%- doc -%}
  Renders a "Size Chart" trigger on the product page. When a product has a
  `custom.size_chart_id` metafield pointing at a chart created in the app,
  clicking the trigger opens a dialog with the chart's content. All button
  appearance (label, color, icon) is controlled from the app's Settings
  page, not here — this block only controls where it sits on the page.
{%- enddoc -%}

{%- assign chart_id = product.metafields.custom.size_chart_id -%}

{% if chart_id %}
  <div class="asc-size-chart-block" data-asc-root {{ block.shopify_attributes }}></div>

  <script>
    (function () {
      var chartId = {{ chart_id | json }};
      var root = document.currentScript.previousElementSibling;

      fetch('/apps/sizechart?chartId=' + encodeURIComponent(chartId))
        .then(function (response) {
          if (!response.ok) throw new Error('Request failed');
          return response.json();
        })
        .then(function (res) {
          if (!res.success) return;
          var settings = res.data.settings || {};
          if (settings.showOnProductPage === false) return;
          renderTrigger(root, res.data, settings);
        })
        .catch(function () {});

      // Mirrors app/services/utils/buttonDesign.js ICON_PATHS. This block
      // renders a plain text-link trigger, so it only picks up the icon
      // choice (not shape/size/border/shadow, which apply to the pill-style
      // floating button in size-chart-embed.liquid).
      var ICON_PATHS = {
        list: '<path d="M21 6H3M21 12H3M21 18H8"></path>',
        ruler: '<path d="M3 17 17 3l4 4L7 21l-4-4Z"></path><path d="m14.5 5.5 2 2"></path><path d="m11.5 8.5 2 2"></path><path d="m8.5 11.5 2 2"></path><path d="m5.5 14.5 2 2"></path>',
        tag: '<path d="M12 2H4a2 2 0 0 0-2 2v8l10.29 10.29a1 1 0 0 0 1.42 0l8.58-8.58a1 1 0 0 0 0-1.42L12 2Z"></path><circle cx="7.5" cy="7.5" r="1.25"></circle>',
        info: '<circle cx="12" cy="12" r="10"></circle><path d="M12 16v-5"></path><path d="M12 8h.01"></path>',
      };

      function renderTrigger(root, data, settings) {
        var blockId = 'asc-' + Math.random().toString(36).slice(2);
        var iconSvg = settings.showIcon
          ? '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">' + (ICON_PATHS[settings.buttonIcon] || ICON_PATHS.list) + '</svg>'
          : '';

        var selectorHtml = '';
        if (settings.sizeSelectorMode === 'app' && data.sizes && data.sizes.length) {
          selectorHtml =
            '<div class="asc-selector">' +
              '<span class="asc-selector__label">Size</span>' +
              '<div class="asc-selector__options" role="radiogroup" aria-label="Size">' +
                data.sizes.map(function (size) {
                  return '<button type="button" class="asc-size-option" role="radio" aria-checked="false" data-asc-size="' + escapeHtml(size) + '">' + escapeHtml(size) + '</button>';
                }).join('') +
              '</div>' +
            '</div>';
        }

        root.innerHTML =
          selectorHtml +
          '<button type="button" class="asc-trigger" style="color:' + (settings.buttonColor || '#1a1a1a') + '" aria-haspopup="dialog" aria-controls="' + blockId + '-dialog" data-asc-open>' +
            iconSvg +
            '<span>' + (settings.buttonLabel || 'Size Chart') + '</span>' +
          '</button>' +
          '<dialog id="' + blockId + '-dialog" class="asc-dialog">' +
            '<div class="asc-dialog__header">' +
              '<h2 class="asc-dialog__title">' + (data.title || settings.buttonLabel || 'Size Chart') + '</h2>' +
              '<button type="button" class="asc-dialog__close" aria-label="Close" data-asc-close>&times;</button>' +
            '</div>' +
            '<div class="asc-dialog__body">' + (data.html || '<p class="asc-error">This size chart has no content yet.</p>') + '</div>' +
          '</dialog>';

        var dialog = root.querySelector('dialog');
        var openBtn = root.querySelector('[data-asc-open]');
        var closeBtn = root.querySelector('[data-asc-close]');

        function openDialog() {
          if (typeof dialog.showModal === 'function') dialog.showModal();
          else dialog.setAttribute('open', '');
        }
        function closeDialog() {
          if (typeof dialog.close === 'function') dialog.close();
          else dialog.removeAttribute('open');
        }

        openBtn.addEventListener('click', openDialog);
        closeBtn.addEventListener('click', closeDialog);
        dialog.addEventListener('click', function (event) {
          if (event.target === dialog) closeDialog();
        });

        if (settings.sizeSelectorMode === 'app') {
          setupSizeSelector(root);
        }
      }

      function setupSizeSelector(root) {
        var form = root.closest('form');
        var hiddenInput = null;

        if (form) {
          hiddenInput = form.querySelector('input[name="properties[Size]"]');
          if (!hiddenInput) {
            hiddenInput = document.createElement('input');
            hiddenInput.type = 'hidden';
            hiddenInput.name = 'properties[Size]';
            form.appendChild(hiddenInput);
          }
        } else if (window.console) {
          console.warn('Size Chart Block: no surrounding <form> found. Place this block inside the product form (e.g. above the Buy Buttons block) so the selected size is added to the cart.');
        }

        var options = root.querySelectorAll('[data-asc-size]');
        options.forEach(function (option) {
          option.addEventListener('click', function () {
            options.forEach(function (o) {
              o.classList.remove('is-selected');
              o.setAttribute('aria-checked', 'false');
            });
            option.classList.add('is-selected');
            option.setAttribute('aria-checked', 'true');
            if (hiddenInput) {
              hiddenInput.value = option.getAttribute('data-asc-size');
            }
          });
        });
      }

      function escapeHtml(value) {
        var div = document.createElement('div');
        div.textContent = value;
        return div.innerHTML;
      }
    })();
  </script>

  <style>
    .asc-size-chart-block:empty {
      display: none;
    }

    .asc-selector {
      margin-bottom: 12px;
    }

    .asc-selector__label {
      display: block;
      font-size: 0.8125rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.02em;
      color: #666;
      margin-bottom: 8px;
    }

    .asc-selector__options {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
    }

    .asc-size-option {
      min-width: 44px;
      padding: 8px 14px;
      border: 1px solid #c9c9c9;
      border-radius: 6px;
      background: #fff;
      font-size: 0.875rem;
      cursor: pointer;
    }

    .asc-size-option:hover {
      border-color: #1a1a1a;
    }

    .asc-size-option.is-selected {
      border-color: #1a1a1a;
      background: #1a1a1a;
      color: #fff;
    }

    .asc-trigger {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: transparent;
      border: none;
      padding: 0;
      margin: 0;
      font: inherit;
      font-size: 0.875rem;
      text-decoration: underline;
      cursor: pointer;
    }

    .asc-trigger:hover {
      opacity: 0.75;
    }

    .asc-dialog {
      width: min(560px, calc(100vw - 32px));
      max-height: min(80vh, 720px);
      border: none;
      border-radius: 12px;
      padding: 0;
      box-shadow: 0 12px 40px rgba(0, 0, 0, 0.2);
    }

    .asc-dialog::backdrop {
      background: rgba(17, 17, 17, 0.5);
    }

    .asc-dialog__header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 16px 20px;
      border-bottom: 1px solid #e4e4e4;
      position: sticky;
      top: 0;
      background: #fff;
    }

    .asc-dialog__title {
      font-size: 1.125rem;
      margin: 0;
    }

    .asc-dialog__close {
      background: none;
      border: none;
      font-size: 1.5rem;
      line-height: 1;
      cursor: pointer;
      padding: 4px 8px;
      color: #666;
    }

    .asc-dialog__body {
      padding: 20px;
      overflow-y: auto;
    }

    .asc-loading,
    .asc-error {
      color: #666;
      font-size: 0.9rem;
    }

    .asc-sizes-heading {
      font-size: 0.8125rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.02em;
      color: #666;
      margin: 0 0 8px;
    }

    .asc-size-list {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
      list-style: none;
      padding: 0;
      margin: 0 0 16px;
    }

    .asc-size-pill {
      border: 1px solid #d5d5d5;
      border-radius: 999px;
      padding: 4px 12px;
      font-size: 0.8125rem;
    }

    .asc-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.875rem;
    }

    .asc-table th,
    .asc-table td {
      text-align: left;
      padding: 8px 10px;
      border-bottom: 1px solid #ececec;
    }

    .asc-table th {
      font-weight: 600;
      background: #fafafa;
    }

    .asc-block--image img {
      max-width: 100%;
      border-radius: 8px;
      margin: 8px 0;
    }

    .asc-block--description {
      font-size: 0.9rem;
      line-height: 1.5;
    }
  </style>
{% endif %}

{% schema %}
{
  "name": "Size Chart Block",
  "target": "section",
  "settings": [],
  "enabled_on": {
    "templates": ["product"]
  }
}
{% endschema %}
