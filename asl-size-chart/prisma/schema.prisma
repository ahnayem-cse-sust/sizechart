// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  previewFeatures = ["relationJoins"]
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "sqlite"
  url      = "file:dev.sqlite"
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
}

model SizeChart {
  id        Int      @id @default(autoincrement())
  title     String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Template {
  id        Int      @id @default(autoincrement())
  title     String
  category  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  charts    Chart[]
}

model TemplateContent {
  id            Int      @id @default(autoincrement())
  serial_no     Int
  template_id   Int
  content_type  String
  content_obj   String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Chart {
  id              Int      @id @default(autoincrement())
  title           String
  available_sizes String
  template_id     Int?
  template        Template? @relation(fields: [template_id], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model ChartContent {
  id            Int      @id @default(autoincrement())
  serial_no     Int
  chart_id      Int
  content_type  String
  content_obj   String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Setting {
  id                       Int      @id @default(autoincrement())
  shop                     String   @unique
  unit                     String   @default("in")
  buttonLabel              String   @default("Size Chart")
  buttonColor              String   @default("#1A1A1A")
  buttonTextColor          String   @default("#FFFFFF")
  buttonPositionVertical   String   @default("bottom")
  buttonPositionHorizontal String   @default("right")
  buttonTextOrientation    String   @default("horizontal")
  buttonShapeTopLeft       String   @default("pill")
  buttonShapeTopRight      String   @default("pill")
  buttonShapeBottomRight   String   @default("pill")
  buttonShapeBottomLeft    String   @default("pill")
  buttonSize               String   @default("medium")
  buttonBorderWidth        Int      @default(0)
  buttonBorderColor        String   @default("#1A1A1A")
  buttonShadow             String   @default("soft")
  buttonIcon               String   @default("list")
  showIcon                 Boolean  @default(true)
  showOnProductPage        Boolean  @default(true)
  sizeSelectorMode         String   @default("theme")
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
}
