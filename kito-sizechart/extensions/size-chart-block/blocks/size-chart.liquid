
{% comment %} <h2>{{ product.metafields.custom.size_chart_id }}</h2>
{% if product.metafields.custom.size_chart_id %}
  <h2>Size chart exist.</h2>
  {% assign chart_id = product.metafields.custom.size_chart_id %}
  <div class="size-chart-container">
    {% assign chart = shop.metaobjects['size_chart'].values | where: "id", chart_id | first %}
    {% if chart %}
      <h2>Size chart found.</h2>
      <h3>{{ chart.title }}</h3>
      <div>{{ chart.content | metafield_tag }}</div>
    {% else %}
      <p>Size chart not found.</p>
    {% endif %}
  </div>
{% endif %}  {% endcomment %}

{%- assign product_form_id = 'product-form-' | append: section.id -%}

<div class="size-chart-block">
  {% if product.metafields.custom.size_chart_id %}
  <div id="sizeChart">Loading size gg chart...</div>

  <input type="hidden" name="id" value="{{ product.variants.first.id }}" />
      <label for="size-select">Select Size:</label>
      <select name="properties[Selected Size]" id="size-select" form="{{ product_form_id }}" required>
        <option value="">-- Choose size --</option>
        <option value="S">S</option>
        <option value="M">M</option>
        <option value="L">L</option>
        <option value="XL">XL</option>
      </select>

  <script>

    document.addEventListener("DOMContentLoaded", function(){
    
      let chart_id = {{ product.metafields.custom.size_chart_id }};
      fetch('https://soma-tradition-jacob-swiss.trycloudflare.com/api/sizechart?chartId='+chart_id)
      .then(response => response.json())
      .then(resData => { 
        console.log(resData);   
        document.getElementById("sizeChart").innerHTML = "<p>"+resData.data.content+"</p>";
      })
      .catch(() => {
        document.getElementById("sizeChart").innerHTML = "<p>Faild to load sizechart.</p>";
      });

    })

  </script>
  {% endif %}
</div>



{% schema %}
{
  "name": "Size Chart Block",
  "target": "section",
  "settings": [],
  "enabled_on": {
    "templates": ["product"]
  }
}
{% endschema %}